---
import BaseLayout from "../../layouts/BaseLayout.astro";

const notes = [
  {
    slug: "the-piece-i-choose",
    title: "我剩下的是自選曲",
    meta: "一張四十年前的照片 ｜ 2026 夏",
    blurb:
      "老爸在家庭群組傳來一張四十年前的照片，東京新橋，阿公抱著六歲的我。指定曲彈完就是彈完了，它證明不了什麼。該放的我都放了，放不掉的只剩這一支。",
    cover: "/notes/the-piece-i-choose/square.jpg",
  },
  {
    slug: "signals",
    title: "訊號",
    meta: "二十年前的自己留下的訊號 ｜ 2026 夏",
    blurb:
      "我把二十年的筆記倒給 AI 讀，它回報的東西比較像考古：想法不是靈光，是沉積。沒有新東西，只有終於輪到它的東西。",
    cover: "/notes/signals/waveform.jpg",
  },
  {
    slug: "bridge-over-troubled-water",
    title: "惡水上的大橋",
    meta: "跟永和道別 ｜ 2026 夏",
    blurb:
      "二十三年前我為了念書來到永和，那年 MSN 暱稱寫著「尋求華麗舞台」。把二十三年打包裝箱之後我才想明白：家不是一個固定的空間，是自己親手打出來的節奏。",
    cover: "/notes/bridge-over-troubled-water/noodles.jpg",
  },
  {
    slug: "your-memory-or-mine",
    title: "這是我的回憶，還是你的回憶",
    meta: "一段影集，和我自己 ｜ 2026 夏",
    blurb:
      "一段影集說，假如此刻其實是未來的你在回放的記憶。我看完想的是：時間是概念，愛也是概念，真正存在的是行動，而行動需要被完整地傳達。",
    cover: "/notes/your-memory-or-mine/memory-b-pensive.jpg",
  },
  {
    slug: "your-own-way",
    title: "活著的姿態",
    meta: "致盼盼 ｜ 2026 夏",
    blurb:
      "盼盼問過我，人活著的意義是什麼。那天我把三台底片相機交給她，阿祖的、我年輕時玩過的，現在輪到她。底片很慢，剛好就是那個答案的形狀。",
    cover: "/notes/your-own-way/cameras.jpg",
  },
  {
    slug: "always-with-you",
    title: "爸爸會一直陪著你",
    meta: "致盼盼 ｜ 2026 夏",
    blurb:
      "女兒臨時打來求救填志願，剩一個多小時。那半小時讓我明白，重心從來不是去外面找來的，是有人需要你、而你剛好在。",
    cover: "/notes/always-with-you/cover.jpg",
  },
  {
    slug: "cai-tuo",
    title: "蔡拖小傳",
    meta: "家族 ｜ 羅東木業",
    blurb:
      "雲林四湖箔子寮漁村出身，在異鄉羅東白手起家的木業人，我的阿公。資料很少的那個人，其實一生很重。",
    cover: "/notes/cai/feast.jpg",
  },
  {
    slug: "grandma",
    title: "記得外婆",
    meta: "家族 ｜ 2026 清明",
    blurb:
      "與外婆黃藍阿惜道別。我已經寫完了，但為什麼還是盯著捕蚊燈一直在哭。",
    cover: "/notes/grandma/young.jpg",
  },
];
---

<BaseLayout title="記事" description="寫給家人的、與工作無關的文字。">
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-16">
    <h1 class="text-3xl sm:text-4xl font-medium leading-tight tracking-tight">
      記事
    </h1>
    <p class="mt-6 text-neutral-500">
      寫給家人的、與工作無關的文字。
    </p>

    <a href="/notes/family" class="famcard">
      <figure class="fc-hero">
        <img src="/notes/the-piece-i-choose/shinbashi-1986.jpg" alt="1986 年東京新橋，阿公、爸爸、媽媽與六歲的我" />
      </figure>
      <div class="fc-body">
        <em>專題</em>
        <h2>家族</h2>
        <p>從泉州的一個漁村，到雲林四湖的箔子寮，再到羅東的木頭與廳堂，然後是東京，然後是我。一條可以上溯的線，第十世到第二十一世。</p>
        <span>看世代軸 →</span>
      </div>
    </a>

    <ul class="mt-12 space-y-10">
      {notes.map((n) => (
        <li class="border-b border-neutral-100 pb-10">
          <a href={`/notes/${n.slug}`} class="flex gap-5 no-underline group">
            {n.cover && (
              <img
                src={n.cover}
                alt={n.title}
                class="w-28 h-28 sm:w-32 sm:h-32 object-cover rounded-lg border border-neutral-200 shrink-0"
              />
            )}
            <div>
              <h2 class="text-lg font-medium group-hover:opacity-70">{n.title}</h2>
              <span class="text-xs text-neutral-400">{n.meta}</span>
              <p class="mt-2 text-sm text-neutral-500 leading-relaxed">{n.blurb}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .famcard {
    display: block;
    margin-top: 3rem;
    padding: 1.4rem;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    background: #fff;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .famcard:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .famcard .fc-hero { margin: 0; }
  .famcard .fc-hero img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid #e5e5e5;
  }
  .famcard .fc-body { margin-top: 1.1rem; }
  .famcard em {
    display: block;
    font-style: normal;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    color: var(--color-accent);
  }
  .famcard h2 {
    font-size: 1.35rem;
    font-weight: 500;
    margin-top: 0.35rem;
    letter-spacing: -0.01em;
  }
  .famcard p {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.8;
    color: #737373;
  }
  .famcard span {
    display: inline-block;
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--color-accent);
  }
</style>
